desc: RCBitNova V0.1 - Bit-Accurate M/S Dynamic EQ (static + Mode A + Mode B Brick)

// License: GPL - http://www.gnu.org/licenses/gpl.html
// Author: Dima Gorelik (design with Claude)
// Bit logic: 1 bit = 6.0206 dB; gain_lin = 2^((macro + micro/100) * bitratio).
// Filters: TPT state-variable (Andy Simper / Cytomic). All state instance-local
// (NOT gmem) - fixes the cross-instance bug of the gmem-based bit EQ.
// Phase 1: static engine, zero-latency, 4 slider bands, no dynamics/GUI.

in_pin:Left
in_pin:Right
out_pin:Left
out_pin:Right

slider1:0<0,1,1{Off,On}>-Bypass
slider2:0<-16,16,1>-Output Macro (bits)
slider3:0<-100,100,0.1>-Output Micro (% bit)
slider4:2<0.1,10,0.1>-Lookahead (ms, Mode B)

slider11:1<0,1,1{Off,On}>B1 Enable
slider12:0<0,4,1{Bell,Low Shelf,High Shelf,High Pass,Low Pass}>B1 Type
slider13:100<20,20000,1>B1 Freq
slider14:0.707<0.1,10,0.001>B1 Q
slider15:0<-16,16,1>B1 Macro (bits)
slider16:0<-100,100,0.1>B1 Micro (% bit)
slider17:1<0,3,0.05>B1 Bit Ratio
slider18:0<0,4,1{Both,Mid,Side,Left,Right}>B1 Placement

slider21:0<0,1,1{Off,On}>B2 Enable
slider22:0<0,4,1{Bell,Low Shelf,High Shelf,High Pass,Low Pass}>B2 Type
slider23:1000<20,20000,1>B2 Freq
slider24:0.707<0.1,10,0.001>B2 Q
slider25:0<-16,16,1>B2 Macro (bits)
slider26:0<-100,100,0.1>B2 Micro (% bit)
slider27:1<0,3,0.05>B2 Bit Ratio
slider28:0<0,4,1{Both,Mid,Side,Left,Right}>B2 Placement

slider31:0<0,1,1{Off,On}>B3 Enable
slider32:0<0,4,1{Bell,Low Shelf,High Shelf,High Pass,Low Pass}>B3 Type
slider33:3000<20,20000,1>B3 Freq
slider34:0.707<0.1,10,0.001>B3 Q
slider35:0<-16,16,1>B3 Macro (bits)
slider36:0<-100,100,0.1>B3 Micro (% bit)
slider37:1<0,3,0.05>B3 Bit Ratio
slider38:0<0,4,1{Both,Mid,Side,Left,Right}>B3 Placement

slider41:0<0,1,1{Off,On}>B4 Enable
slider42:0<0,4,1{Bell,Low Shelf,High Shelf,High Pass,Low Pass}>B4 Type
slider43:10000<20,20000,1>B4 Freq
slider44:0.707<0.1,10,0.001>B4 Q
slider45:0<-16,16,1>B4 Macro (bits)
slider46:0<-100,100,0.1>B4 Micro (% bit)
slider47:1<0,3,0.05>B4 Bit Ratio
slider48:0<0,4,1{Both,Mid,Side,Left,Right}>B4 Placement

slider51:0<0,1,1{Off,On}>B1 Dyn
slider52:0<0,2,1{Linked,Dual L/R,Dual M/S}>B1 Dyn Stereo (Both only)
slider53:1<0,16,1>B1 Ceiling Macro (bits below 0)
slider54:0<-100,100,0.1>B1 Ceiling Micro (% bit)
slider55:1<0.05,50,0.01>B1 Attack (ms)
slider56:80<1,500,1>B1 Release (ms)
slider57:0<0,1,1{A Dynamic EQ,B Band-Split}>B1 Dyn Mode

slider61:0<0,1,1{Off,On}>B2 Dyn
slider62:0<0,2,1{Linked,Dual L/R,Dual M/S}>B2 Dyn Stereo (Both only)
slider63:1<0,16,1>B2 Ceiling Macro (bits below 0)
slider64:0<-100,100,0.1>B2 Ceiling Micro (% bit)
slider65:1<0.05,50,0.01>B2 Attack (ms)
slider66:80<1,500,1>B2 Release (ms)
slider67:0<0,1,1{A Dynamic EQ,B Band-Split}>B2 Dyn Mode

slider71:0<0,1,1{Off,On}>B3 Dyn
slider72:0<0,2,1{Linked,Dual L/R,Dual M/S}>B3 Dyn Stereo (Both only)
slider73:1<0,16,1>B3 Ceiling Macro (bits below 0)
slider74:0<-100,100,0.1>B3 Ceiling Micro (% bit)
slider75:1<0.05,50,0.01>B3 Attack (ms)
slider76:80<1,500,1>B3 Release (ms)
slider77:0<0,1,1{A Dynamic EQ,B Band-Split}>B3 Dyn Mode

slider81:0<0,1,1{Off,On}>B4 Dyn
slider82:0<0,2,1{Linked,Dual L/R,Dual M/S}>B4 Dyn Stereo (Both only)
slider83:1<0,16,1>B4 Ceiling Macro (bits below 0)
slider84:0<-100,100,0.1>B4 Ceiling Micro (% bit)
slider85:1<0.05,50,0.01>B4 Attack (ms)
slider86:80<1,500,1>B4 Release (ms)
slider87:0<0,1,1{A Dynamic EQ,B Band-Split}>B4 Dyn Mode

@init

N_BANDS = 4;
cf = 0;     // coeffs: 8 slots per band (instance-local memory, NOT gmem)
st = 64;    // state: 4 slots per band (M ic1,ic2; S ic1,ic2)
memset(st, 0, N_BANDS * 4);

// Dynamics (Phase 2b) instance-local memory
det = 96;   // detector bandpass coeffs: 4/band (a1,a2,a3,k)
dst = 128;  // detector state: 4/band (chA ic1,ic2 ; chB ic1,ic2)
cst = 160;  // cut SVF state:  4/band (chA ic1,ic2 ; chB ic1,ic2)
dp  = 192;  // dyn params: 4/band (ceil_lin, atk, rel, dynOn)
dm  = 208;  // dyn stereo mode: 1/band (0 Linked,1 Dual L/R,2 Dual M/S)
bp  = 216;  // band params: 3/band (fc, q, cg)
eg  = 256;  // env_gain: 2/band (chA, chB)
memset(dst, 0, N_BANDS * 4);
memset(cst, 0, N_BANDS * 4);
i = 0; loop(N_BANDS * 2, eg[i] = 1; i += 1;);
anti = pow(2, -100);  // anti-denormal toggle (~8e-31; EEL2 rejects 1e-30 literal)

// Mode B (Phase 3a) instance-local memory
MAX_LOOK = 2048;   // covers the 10 ms slider max up to 192 kHz (1920 samples)
mb_band = 1024;    // band ring: per (band,channel) MAX_LOOK each (cs = b*2+c)
mb_peak = mb_band + N_BANDS * 2 * MAX_LOOK;
mb_end  = mb_peak + N_BANDS * 2 * MAX_LOOK;
memset(mb_band, 0, mb_end - mb_band);
mbenv  = mb_end;               // Mode-B env per (band,channel): 2/band
mbmode = mbenv + N_BANDS * 2;  // Dyn Mode per band (0 A, 1 B)
mbwpos = mbmode + N_BANDS;     // Mode-B write pos per band
bus_dry = mbwpos + N_BANDS;    // shared stereo dry delay (L at [0..], R at [MAX_LOOK..])
bus_wp = 0;
memset(bus_dry, 0, MAX_LOOK * 2);
i = 0; loop(N_BANDS * 2, mbenv[i] = 1; i += 1;);
memset(mbwpos, 0, N_BANDS);

// TPT-SVF (Simper) coefficients for one band. A = sqrt(glin).
// Writes a1,a2,a3,k,m0,m1,m2 into cf[base+0..6].
function svf_set(base, ftype, fc, q, glin)
  local(A, g, k, m0, m1, m2, a1, a2, a3)
(
  A = sqrt(glin);
  ftype == 0 ? (                 // Bell
    g = tan($pi * fc / srate); k = 1 / (q * A);
    m0 = 1; m1 = k * (A * A - 1); m2 = 0;
  ) : ftype == 1 ? (             // Low Shelf
    g = tan($pi * fc / srate) / sqrt(A); k = 1 / q;
    m0 = 1; m1 = k * (A - 1); m2 = A * A - 1;
  ) : ftype == 2 ? (             // High Shelf
    g = tan($pi * fc / srate) * sqrt(A); k = 1 / q;
    m0 = A * A; m1 = k * (1 - A) * A; m2 = 1 - A * A;
  ) : ftype == 3 ? (             // High Pass
    g = tan($pi * fc / srate); k = 1 / q;
    m0 = 1; m1 = -k; m2 = -1;
  ) : (                          // Low Pass
    g = tan($pi * fc / srate); k = 1 / q;
    m0 = 0; m1 = 0; m2 = 1;
  );
  a1 = 1 / (1 + g * (g + k)); a2 = g * a1; a3 = g * a2;
  cf[base]   = a1; cf[base+1] = a2; cf[base+2] = a3; cf[base+3] = k;
  cf[base+4] = m0; cf[base+5] = m1; cf[base+6] = m2;
);

function setup_band(b)
  local(s, glin)
(
  s = 10 * (b + 1);                                  // slider base: 10,20,30,40
  glin = pow(2, (slider(s+5) + slider(s+6) * 0.01) * slider(s+7));
  svf_set(b * 8, slider(s+2), slider(s+3), slider(s+4), glin);
);

function setup_band_dyn(b)
  local(s, ds, fc, q, g, k, a1, a2, a3)
(
  s = 10 * (b + 1); ds = 50 + 10 * b;
  fc = slider(s + 3); q = slider(s + 4);
  g = tan($pi * fc / srate); k = 1 / q;              // detector bandpass, unity at fc
  a1 = 1 / (1 + g * (g + k)); a2 = g * a1; a3 = g * a2;
  det[b*4] = a1; det[b*4+1] = a2; det[b*4+2] = a3; det[b*4+3] = k;
  dp[b*4]   = pow(2, -(slider(ds+3) + slider(ds+4) * 0.01));   // ceil_lin
  dp[b*4+1] = exp(-1 / (slider(ds+5) * 0.001 * srate));        // atk
  dp[b*4+2] = exp(-1 / (slider(ds+6) * 0.001 * srate));        // rel
  dp[b*4+3] = slider(ds+1);                                    // dynOn
  dm[b]     = slider(ds+2);                                    // 0 Linked,1 DualLR,2 DualMS
  bp[b*3] = fc; bp[b*3+1] = q; bp[b*3+2] = tan($pi * fc / srate);
);

@slider

out_gain = pow(2, slider2 + slider3 * 0.01);
b = 0;
loop(N_BANDS, setup_band(b); setup_band_dyn(b); b += 1;);

// Mode-B global lookahead + PDC
Lk = floor(slider4 * 0.001 * srate + 0.5);
Lk = min(max(Lk, 1), MAX_LOOK - 1);
any_b = 0;
b = 0;
loop(N_BANDS,
  mbmode[b] = slider(50 + 10 * b + 7);                                       // 0 A, 1 B
  (slider(50 + 10*b + 1) == 1 && mbmode[b] == 1 && slider(10*(b+1)+2) == 0) ? any_b = 1;
  b += 1;
);
pdc_delay = (slider1 != 1 && any_b) ? Lk : 0;   // 0 when bypassed (passthrough is zero-latency)
pdc_bot_ch = 0; pdc_top_ch = 2;

@sample

// Running signal stays L/R. Each band derives its working domain by placement.
// Bypass (slider1==1) leaves spl0/spl1 untouched = clean pass-through.
slider1 != 1 ? (
  anti = -anti; spl0 += anti; spl1 += anti;     // anti-denormal
  b = 0;
  loop(N_BANDS,
    slider(10 * (b + 1) + 1) == 1 ? (         // enable
      base = b * 8; sb = b * 4;
      a1 = cf[base]; a2 = cf[base+1]; a3 = cf[base+2];
      m0 = cf[base+4]; m1 = cf[base+5]; m2 = cf[base+6];
      pl = slider(10 * (b + 1) + 8);          // 0 Both,1 Mid,2 Side,3 Left,4 Right
      both_ms = 0;

      pl == 0 ? (                             // Both: domain by dyn mode
        (dp[b*4+3] == 1 && dm[b] == 2) ? (    // dyn on + Dual M/S -> work in M/S
          mid = (spl0 + spl1) * 0.5; sid = (spl0 - spl1) * 0.5;
          chA = mid; chB = sid; both_ms = 1;
        ) : (
          chA = spl0; chB = spl1;
        );
        do_b = 1;
      ) : pl == 3 ? (                         // Left -> L only
        chA = spl0; do_b = 0;
      ) : pl == 4 ? (                         // Right -> R only
        chA = spl1; do_b = 0;
      ) : (                                   // Mid/Side -> M/S
        mid = (spl0 + spl1) * 0.5; sid = (spl0 - spl1) * 0.5;
        pl == 1 ? ( chA = mid; ) : ( chA = sid; );
        do_b = 0;
      );

      // Filter channel A (slot A state)
      ic1 = st[sb]; ic2 = st[sb+1];
      v3 = chA - ic2; v1 = a1*ic1 + a2*v3; v2 = ic2 + a2*ic1 + a3*v3;
      st[sb] = 2*v1 - ic1; st[sb+1] = 2*v2 - ic2;
      chA = m0*chA + m1*v1 + m2*v2;

      // Filter channel B if needed (Both; slot B state)
      do_b ? (
        ic1 = st[sb+2]; ic2 = st[sb+3];
        v3 = chB - ic2; v1 = a1*ic1 + a2*v3; v2 = ic2 + a2*ic1 + a3*v3;
        st[sb+2] = 2*v1 - ic1; st[sb+3] = 2*v2 - ic2;
        chB = m0*chB + m1*v1 + m2*v2;
      );

      // ----- Dynamics (Mode A Soft): Bell type only, Dyn on, Dyn Mode A -----
      (dp[b*4+3] == 1 && slider(10*(b+1)+2) == 0 && mbmode[b] == 0) ? (
        qb = bp[b*3+1]; cg = bp[b*3+2];
        da1 = det[b*4]; da2 = det[b*4+1]; da3 = det[b*4+2]; dk = det[b*4+3];
        ceil = dp[b*4]; atk = dp[b*4+1]; rel = dp[b*4+2];
        linked = (pl == 0) && (dm[b] == 0);

        // detector on chA
        ic1 = dst[sb]; ic2 = dst[sb+1];
        v3 = chA - ic2; v1 = da1*ic1 + da2*v3; v2 = ic2 + da2*ic1 + da3*v3;
        dst[sb] = 2*v1 - ic1; dst[sb+1] = 2*v2 - ic2;
        levA = abs(dk * v1);
        levB = 0;
        do_b ? (
          ic1 = dst[sb+2]; ic2 = dst[sb+3];
          v3 = chB - ic2; v1 = da1*ic1 + da2*v3; v2 = ic2 + da2*ic1 + da3*v3;
          dst[sb+2] = 2*v1 - ic1; dst[sb+3] = 2*v2 - ic2;
          levB = abs(dk * v1);
        );

        linked ? (
          lev = max(levA, levB);
          gr = lev > ceil ? ceil / lev : 1;
          ea = eg[b*2]; coef = gr < ea ? atk : rel; ea = gr + (ea - gr) * coef;
          eg[b*2] = ea; eg[b*2+1] = ea;
        ) : (
          gr = levA > ceil ? ceil / levA : 1;
          ea = eg[b*2]; coef = gr < ea ? atk : rel; ea = gr + (ea - gr) * coef; eg[b*2] = ea;
          do_b ? (
            gr = levB > ceil ? ceil / levB : 1;
            eb = eg[b*2+1]; coef = gr < eb ? atk : rel; eb = gr + (eb - gr) * coef; eg[b*2+1] = eb;
          );
        );

        // cut chA
        A = sqrt(eg[b*2]); ck = 1 / (qb * A);
        ca1 = 1 / (1 + cg * (cg + ck)); ca2 = cg * ca1; ca3 = cg * ca2; cm1 = ck * (A*A - 1);
        ic1 = cst[sb]; ic2 = cst[sb+1];
        v3 = chA - ic2; v1 = ca1*ic1 + ca2*v3; v2 = ic2 + ca2*ic1 + ca3*v3;
        cst[sb] = 2*v1 - ic1; cst[sb+1] = 2*v2 - ic2;
        chA = chA + cm1 * v1;

        do_b ? (
          A = sqrt(eg[b*2+1]); ck = 1 / (qb * A);
          ca1 = 1 / (1 + cg * (cg + ck)); ca2 = cg * ca1; ca3 = cg * ca2; cm1 = ck * (A*A - 1);
          ic1 = cst[sb+2]; ic2 = cst[sb+3];
          v3 = chB - ic2; v1 = ca1*ic1 + ca2*v3; v2 = ic2 + ca2*ic1 + ca3*v3;
          cst[sb+2] = 2*v1 - ic1; cst[sb+3] = 2*v2 - ic2;
          chB = chB + cm1 * v1;
        );
      );

      // Write working channels back to L/R
      pl == 0 ? ( both_ms ? ( spl0 = chA + chB; spl1 = chA - chB; ) : ( spl0 = chA; spl1 = chB; ) ) :
      pl == 3 ? ( spl0 = chA; ) :
      pl == 4 ? ( spl1 = chA; ) :
      pl == 1 ? ( spl0 = chA + sid; spl1 = chA - sid; ) :  // Mid filtered, side intact
                ( spl0 = mid + chA; spl1 = mid - chA; );    // Side filtered, mid intact
    );
    b += 1;
  );

  // ===== Mode B (Brick, band-split, bit-exact) on the globally-delayed bus =====
  any_b ? (
    L_in = spl0; R_in = spl1;          // intermediate (post static + Mode-A)
    corrL = 0; corrR = 0;
    b = 0;
    loop(N_BANDS,
      (slider(50 + 10*b + 1) == 1 && mbmode[b] == 1 && slider(10*(b+1)+2) == 0) ? (
        pl = slider(10*(b+1)+8);
        qb = bp[b*3+1];
        da1 = det[b*4]; da2 = det[b*4+1]; da3 = det[b*4+2]; dk = det[b*4+3];
        ceil = dp[b*4]; rel = dp[b*4+2];
        linked = (pl == 0) && (dm[b] == 0);

        ms_dom = 0; two = 0;
        pl == 0 ? (
          (dm[b] == 2) ? ( xa = (L_in + R_in)*0.5; xb = (L_in - R_in)*0.5; ms_dom = 1; ) :
                         ( xa = L_in; xb = R_in; );
          two = 1;
        ) : pl == 1 ? ( xa = (L_in + R_in)*0.5; ms_dom = 1; ) :
            pl == 2 ? ( xa = (L_in - R_in)*0.5; ms_dom = 1; ) :
            pl == 3 ? ( xa = L_in; ) : ( xa = R_in; );

        wp = mbwpos[b];
        csA = b*2; csB = b*2 + 1;
        baseA = csA*MAX_LOOK; baseB = csB*MAX_LOOK;

        // channel A: extract band (detector state slot A), ring write, worst-peak
        ic1 = dst[b*4]; ic2 = dst[b*4+1];
        v3 = xa - ic2; v1 = da1*ic1 + da2*v3; v2 = ic2 + da2*ic1 + da3*v3;
        dst[b*4] = 2*v1 - ic1; dst[b*4+1] = 2*v2 - ic2;
        bA = dk * v1;
        mb_band[baseA + wp] = bA; mb_peak[baseA + wp] = abs(bA);
        worstA = 0; i = 0;
        loop(Lk + 1, p = mb_peak[baseA + ((wp - i + MAX_LOOK) % MAX_LOOK)]; p > worstA ? worstA = p; i += 1;);

        two ? (
          ic1 = dst[b*4+2]; ic2 = dst[b*4+3];
          v3 = xb - ic2; v1 = da1*ic1 + da2*v3; v2 = ic2 + da2*ic1 + da3*v3;
          dst[b*4+2] = 2*v1 - ic1; dst[b*4+3] = 2*v2 - ic2;
          bB = dk * v1;
          mb_band[baseB + wp] = bB; mb_peak[baseB + wp] = abs(bB);
          worstB = 0; i = 0;
          loop(Lk + 1, p = mb_peak[baseB + ((wp - i + MAX_LOOK) % MAX_LOOK)]; p > worstB ? worstB = p; i += 1;);
        );

        linked ? (
          worst = max(worstA, worstB);
          tgt = worst > ceil ? ceil / worst : 1;
          ea = mbenv[csA]; tgt < ea ? ea = tgt : ( ea = tgt + (ea - tgt)*rel; ea = min(ea,1); );
          mbenv[csA] = ea; mbenv[csB] = ea;
        ) : (
          tgt = worstA > ceil ? ceil / worstA : 1;
          ea = mbenv[csA]; tgt < ea ? ea = tgt : ( ea = tgt + (ea - tgt)*rel; ea = min(ea,1); ); mbenv[csA] = ea;
          two ? (
            tgt = worstB > ceil ? ceil / worstB : 1;
            eb = mbenv[csB]; tgt < eb ? eb = tgt : ( eb = tgt + (eb - tgt)*rel; eb = min(eb,1); ); mbenv[csB] = eb;
          );
        );

        rpos = (wp - Lk + MAX_LOOK) % MAX_LOOK;
        bdA = mb_band[baseA + rpos];
        limA = bdA * mbenv[csA]; abs(limA) > ceil ? (limA = limA > 0 ? ceil : -ceil);
        dcA = limA - bdA;
        two ? (
          bdB = mb_band[baseB + rpos];
          limB = bdB * mbenv[csB]; abs(limB) > ceil ? (limB = limB > 0 ? ceil : -ceil);
          dcB = limB - bdB;
        );

        pl == 0 ? (
          ms_dom ? ( corrL += dcA + dcB; corrR += dcA - dcB; ) : ( corrL += dcA; corrR += dcB; );
        ) : pl == 1 ? ( corrL += dcA; corrR += dcA; ) :
            pl == 2 ? ( corrL += dcA; corrR -= dcA; ) :
            pl == 3 ? ( corrL += dcA; ) : ( corrR += dcA; );

        mbwpos[b] = (wp + 1) % MAX_LOOK;
      );
      b += 1;
    );

    // delayed dry L/R bus + accumulated band corrections
    bus_dry[bus_wp] = L_in; bus_dry[bus_wp + MAX_LOOK] = R_in;
    rp = (bus_wp - Lk + MAX_LOOK) % MAX_LOOK;
    spl0 = bus_dry[rp] + corrL;
    spl1 = bus_dry[rp + MAX_LOOK] + corrR;
    bus_wp = (bus_wp + 1) % MAX_LOOK;
  );

  spl0 *= out_gain;
  spl1 *= out_gain;
);
